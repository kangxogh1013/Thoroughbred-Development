    riskyChoice: "\uD568\uAED8 \uBCD1\uC8FC\uC2DC\uD0A8\uB2E4"
    safeChoice: "\uB5BC\uC5B4\uB193\uB294\uB2E4"
  - text: "\uAC11\uC790\uAE30 \uC18C\uB098\uAE30\uAC00 \uC3DF\uC544\uC9D1\uB2C8\uB2E4."
