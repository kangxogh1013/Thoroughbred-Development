  trainingEvents:
  - text: "\uB9D0\uC774 \uB2F9\uADFC\uC744 \uBCF4\uACE0 \uD765\uBD84\uD588\uC2B5\uB2C8\uB2E4!"
    riskyChoice: "\uB2F9\uADFC\uC744 \uC900\uB2E4"
