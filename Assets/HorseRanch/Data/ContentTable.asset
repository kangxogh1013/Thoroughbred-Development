    safeChoice: "\uC7A0\uC2DC \uC26C\uAC8C \uD55C\uB2E4"
  - text: "\uC606 \uB9C8\uBC29\uC758 \uB9D0\uC5D0\uAC8C \uAC15\uD55C \uACBD\uC7C1\uC2EC\uC744
