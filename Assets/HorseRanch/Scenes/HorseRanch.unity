--- !u!114 &1442370698
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1442370696}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61eef69217190f34c86a1a9c5d8b272d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HorseRanch.Interactable
  kind: 0
  displayName: "\uD654\uAC00"
  lines:
  - "\uC624\uB298 \uACBD\uC8FC \uB9C8\uAD8C \uC0C0\uC5B4? \uB3C4\uBC15\uC7A5\uC740
    \uBD81\uCABD \uBCF4\uB77C\uC0C9 \uC9C0\uBD95 \uAC74\uBB3C\uC774\uC57C."
  - "\uC801\uC911\uD55C \uB9C8\uAD8C\uC740 \uB3C4\uBC15\uC7A5 \uAD50\uD658\uC18C\uC5D0\uC11C
    \uB3C8\uC73C\uB85C \uBC14\uAFD4\uC918. \uC78A\uC9C0 \uB9C8!"
  - "\uC0BC\uC30D\uC2B9\uC2DD \uB9DE\uCD94\uBA74 \uB300\uBC15\uC774\uB798. \uADFC\uB370
    336\uAC00\uC9C0 \uC911 \uD558\uB098\uB77C\uB2C8\u2026"
  - "\uB9D0\uC774 \uD53C\uACE4\uD558\uBA74 \uACBD\uC8FC\uC5D0\uC11C \uB290\uB824\uC9C4\uB2E4\uB354\uB77C.
    \uB9C8\uAD6C\uAC04\uC5D0\uC11C \uC26C\uAC8C \uD574."
  - "\uACBD\uAE30\uC7A5 \uC9C4\uD589\uC694\uC6D0\uD55C\uD14C \uB9D0 \uAC78\uBA74
    \uD2B8\uB799\uC5D0\uC11C \uACBD\uC8FC\uB97C \uBCFC \uC218 \uC788\uC5B4."
  - "7\uC77C\uB9C8\uB2E4 \uB300\uC0C1\uACBD\uC8FC\uAC00 \uC5F4\uB824. \uC0C1\uAE08\uC774
    \uC138 \uBC30\uB77C\uB2C8\uAE4C!"
  - "\uAD11\uC7A5 \uAC8C\uC2DC\uD310\uC5D0 \uC5B4\uC81C \uC6B0\uC2B9\uB9C8\uB791
    \uB0B4\uC77C \uB098\uC62C \uB9D0 \uC815\uBCF4\uAC00 \uBD99\uC5B4."
  - "\uBD84\uC218\uC5D0 \uB3D9\uC804 \uB358\uC9C0\uBA74 \uADF8\uB0A0 \uB9C8\uAD8C
    \uC6B4\uC774 \uC88B\uC544\uC9C4\uB300."
  - "\uC9D1 \uCE68\uB300\uC5D0\uC11C \uC790\uBA74 \uB2E4\uC74C \uB0A0\uC774 \uB3FC.
    \uC548 \uBCF8 \uACBD\uC8FC\uB294 \uC54C\uC544\uC11C \uC9C4\uD589\uB3FC."
  - "\uB3D9\uCABD \uACF5\uC6D0 \uB05D \uC232\uC18D\uC5D0 \uB3C4\uBC15 \uACE0\uC218\uAC00
    \uC0B0\uB2E4\uB354\uB77C. \uB098\uBB34 \uC0AC\uC774\uB85C \uAE38\uC774 \uC788\uB300."
  - "Shift \uB204\uB974\uBA74 \uB6F8 \uC218 \uC788\uC5B4. \uB9C8\uC744\uC774 \uB113\uC73C\uB2C8\uAE4C
    M \uD0A4\uB85C \uC9C0\uB3C4\uB97C \uBD10."
  - "\uC5C5\uC801\uC740 J \uD0A4, \uC778\uBCA4\uD1A0\uB9AC\uB294 Tab \uD0A4\uB85C
    \uBCFC \uC218 \uC788\uB300."
  - "\uC2DC\uC7A5 \uACE0\uAE09 \uC0AC\uB8CC\uB294 \uBA39\uC774\uBA74 \uC2A4\uD0EF\uC774
    \uC601\uAD6C\uD788 \uC624\uB978\uB300. \uD558\uB8E8\uC5D0 \uC0B4 \uC218 \uC788\uB294
    \uAC1C\uC218\uB294 \uC815\uD574\uC838 \uC788\uC9C0\uB9CC."
  - "\uC4F0\uB808\uAE30\uD1B5 \uB4A4\uC9C0\uB294 \uC0AC\uB78C \uBD24\uC5B4? E\uB97C
    \uC5C4\uCCAD \uBE68\uB9AC \uB204\uB974\uB354\uB77C. \uAC00\uB054 \uB3C8\uB3C4
    \uB098\uC628\uB2E4\uB098?"
  - "\uBCA4\uCE58\uC5D0 \uC549\uC544 \uC788\uC73C\uBA74 \uBCC4\uBCC4 \uC18C\uBB38\uC774
    \uB2E4 \uB4E4\uB824."
  - "\uC8FC\uC6B4 \uC4F0\uB808\uAE30\uB294 \uC544\uBB34 \uB370\uB098 \uBC84\uB9AC\uBA74
    \uC548 \uB3FC! \uC4F0\uB808\uAE30\uD1B5\uC5D0\uB9CC \uBC84\uB824."
  cells: []
  triggerOnStep: 0
  warpCell: {x: 0, y: 0}
  warpFacing: {x: 0, y: 0}
  param: -1
  map: {fileID: 1783980086}
