  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 61eef69217190f34c86a1a9c5d8b272d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HorseRanch.Interactable
  kind: 0
  displayName: "\uC0B0\uCC45\uD558\uB294 \uC8FC\uBBFC"
  lines:
  - "\uC624\uB298 \uACBD\uC8FC \uB9C8\uAD8C \uC0C0\uC5B4? \uB3C4\uBC15\uC7A5\uC740
    \uBD81\uCABD \uBCF4\uB77C\uC0C9 \uC9C0\uBD95 \uAC74\uBB3C\uC774\uC57C."
  - "\uC801\uC911\uD55C \uB9C8\uAD8C\uC740 \uB3C4\uBC15\uC7A5 \uAD50\uD658\uC18C\uC5D0\uC11C
    \uB3C8\uC73C\uB85C \uBC14\uAFD4\uC918. \uC78A\uC9C0 \uB9C8!"
  - "\uC0BC\uC30D\uC2B9\uC2DD \uB9DE\uCD94\uBA74 \uB300\uBC15\uC774\uB798. \uADFC\uB370
    336\uAC00\uC9C0 \uC911 \uD558\uB098\uB77C\uB2C8\u2026"
  - "\uB9D0\uC774 \uD53C\uACE4\uD558\uBA74 \uACBD\uC8FC\uC5D0\uC11C \uB290\uB824\uC9C4\uB2E4\uB354\uB77C.
    \uAC00\uB054 \uC26C\uAC8C \uD574."
  - "\uACBD\uAE30\uC7A5 \uC9C4\uD589\uC694\uC6D0\uD55C\uD14C \uB9D0 \uAC78\uBA74
    \uACBD\uC8FC\uB97C \uBCFC \uC218 \uC788\uC5B4."
  - "7\uC77C\uB9C8\uB2E4 \uB300\uC0C1\uACBD\uC8FC\uAC00 \uC5F4\uB824. \uC0C1\uAE08\uC774
    \uC138 \uBC30\uB77C\uB2C8\uAE4C!"
  - "\uAD11\uC7A5 \uAC8C\uC2DC\uD310\uC5D0\uC11C \uC5B4\uC81C \uACB0\uACFC\uB791
    \uC624\uB298 \uC778\uAE30\uB9C8\uB97C \uBCFC \uC218 \uC788\uC5B4."
  - "\uB9C8\uC2DC\uC7A5 \uB9D0\uC740 \uC0AC\uAE30 \uC804\uC5D4 \uB2A5\uB825\uCE58\uB97C
    \uBAA8\uB978\uB300. \uC644\uC804 \uB3C4\uBC15\uC774\uC9C0."
  - "\uC9D1\uC5D0\uC11C \uC790\uBA74 \uB2E4\uC74C \uB0A0\uC774 \uB3FC. \uC548 \uBCF8
    \uACBD\uC8FC\uB294 \uC54C\uC544\uC11C \uC9C4\uD589\uB41C\uB2E4\uACE0."
  - "\uB3C4\uBC15\uC7A5 \uAD6C\uC11D\uC5D0 \uC815\uBCF4\uD1B5 \uC544\uC800\uC528
    \uC788\uC796\uC544. \uAC00\uB054 \uB9DE\uB354\uB77C\uACE0."
  - "Shift \uB204\uB974\uBA74 \uB6F8 \uC218 \uC788\uC5B4. \uBC14\uC060 \uB550 \uB6F0\uC5B4!"
  - "\uC5C5\uC801\uC740 J \uD0A4, \uC778\uBCA4\uD1A0\uB9AC\uB294 Tab \uD0A4\uB85C
    \uBCFC \uC218 \uC788\uB300."
  cells: []
  triggerOnStep: 0
  warpCell: {x: 0, y: 0}
  warpFacing: {x: 0, y: 0}
  map: {fileID: 1240706196}
