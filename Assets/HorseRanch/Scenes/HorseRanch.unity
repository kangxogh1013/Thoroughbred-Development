  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HorseRanch.Interactable
  kind: 0
  displayName: "\uAD00\uC911"
  lines:
  - "\uC640! \uC800 \uB9D0 \uBD10, \uB9C9\uD310\uC5D0 \uCE58\uACE0 \uB098\uC624\uC796\uC544!"
  - "\uC9C4\uD589\uC694\uC6D0\uD55C\uD14C \uB9D0\uD558\uBA74 \uBC14\uB85C \uBC1C\uC8FC\uD574.
    \uB9C8\uAD8C\uC740 \uBBF8\uB9AC \uC0AC \uB46C."
  - "\uB0B4 \uB9D0\uC774 \uC5C6\uC5B4\uB3C4 \uACBD\uC8FC\uB294 \uB9E4\uC77C \uC5F4\uB824.
    \uAD6C\uACBD\uD558\uB294 \uC7AC\uBBF8\uAC00 \uC3E0\uC3E0\uD558\uC9C0."
  - "\uC7A5\uAC70\uB9AC\uB294 \uCCB4\uB825 \uC5C6\uC73C\uBA74 \uB9C9\uD310\uC5D0
    \uB2E4 \uD37C\uC838."
  - "\uCD9C\uBC1C \uAC8C\uC774\uD2B8\uC5D0\uC11C \uD55C \uC904\uB85C \uC11C \uC788\uB2E4\uAC00
    \uC77C\uC81C\uD788 \uD280\uC5B4\uB098\uAC00\uB294 \uAC8C \uC7A5\uAD00\uC774\uC57C."
