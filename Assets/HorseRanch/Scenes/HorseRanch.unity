  - "\uC5B4\uC81C \uC0BC\uC30D\uC2B9 \uD558\uB098 \uCC28\uC774\uB85C \uB193\uCCE4\uC5B4\u2026
    \uB2E4 \uC7A1\uC558\uB294\uB370!"
  - "\uBC30\uB2F9\uC774 \uB0AE\uC740 \uB9D0\uC740 \uB2E4\uB4E4 \uAC70\uAE30 \uAC78\uC5C8\uB2E4\uB294
    \uB73B\uC774\uC57C. \uADF8\uB9CC\uD07C \uB35C \uBC1B\uC9C0."
  - "\uC5F0\uC2B9\uC2DD\uC740 3\uC704 \uC548\uC5D0\uB9CC \uB4E4\uBA74 \uB3FC. \uCD08\uBCF4\uB294
    \uC774\uAC78\uB85C \uC2DC\uC791\uD574."
  - "\uC804\uAD11\uD310 \uBC30\uB2F9\uC740 \uC0AC\uB78C\uB4E4\uC774 \uB3C8 \uAC78
    \uB54C\uB9C8\uB2E4 \uBC14\uB010\uB2E4\uACE0."
  - "\uC801\uC911 \uB9C8\uAD8C\uC740 \uAD50\uD658\uC18C\uC5D0\uC11C \uBC14\uAFD4\uC57C
    \uB3C8\uC774 \uB3FC. \uC8FC\uBA38\uB2C8\uC5D0 \uB123\uC5B4 \uB450\uBA74 \uADF8\uB0E5
    \uC885\uC774\uC57C."
  - "\uC624\uB298 \uCEE8\uB514\uC158 \uC88B\uC740 \uB9D0\uC774 \uB204\uAD70\uC9C0
    \uC54C\uBA74 \uC88B\uC744 \uD150\uB370\u2026"
  cells: []
  triggerOnStep: 0
  warpCell: {x: 0, y: 0}
  warpFacing: {x: 0, y: 0}
