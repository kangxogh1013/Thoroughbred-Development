  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HorseRanch.Interactable
  kind: 16
  displayName: "\uCC45\uC7A5"
  lines:
  - "\uCC45\uC774 \uBE7D\uBE7D\uD558\uAC8C \uAF42\uD78C \uCC45\uC7A5\uC774\uB2E4.
    \uC0B4\uD3B4\uBCFC\uAE4C?"
  - "\u300E\uACBD\uB9C8 \uC785\uBB38 \u2014 \uD30C\uB9AC\uBBA4\uCD94\uC5BC\uC758
    \uBAA8\uB4E0 \uAC83\u300F. \uC5B4\uB835\uB2E4\u2026"
  - "\u300E\uB9D0\uACFC \uD568\uAED8\uD55C 30\uB144\u300F. \uBA3C\uC9C0\uAC00 \uC218\uBD81\uD558\uB2E4."
  - "\uC694\uB9AC\uCC45 \uC0AC\uC774\uC5D0 \uB9C8\uAD8C \uD55C \uC7A5\u2026 7\uB144
    \uC804 \uAF5D \uB9C8\uAD8C\uC774\uB2E4."
  - "\u300E\uCD08\uBCF4 \uBAA9\uC7A5\uC8FC\uB97C \uC704\uD55C \uC0AC\uB8CC\uD559\u300F.
    \uBC11\uC904\uC774 \uC794\uB729 \uADF8\uC5B4\uC838 \uC788\uB2E4."
  - "\uC544\uBB34\uAC83\uB3C4 \uC5C6\uB2E4. \uCC45 \uB0C4\uC0C8\uB9CC \uB09C\uB2E4."
